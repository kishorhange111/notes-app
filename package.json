{
  "name": "notes-app",
  "version": "1.0.0",
  "description": "Command-line note-taking app built with Node.js and yargs",
  "main": "src/notes.js",
  "bin": {
    "notes": "bin/notes.js"
  },
  "scripts": {
    "start": "node bin/notes.js",
    "help": "node bin/notes.js --help",
    "test": "node --test",
    "lint": "eslint .",
    "check": "npm run lint && npm test"
  },
  "keywords": [
    "nodejs",
    "cli",
    "yargs",
    "notes"
  ],
  "author": "Kishor Hange",
